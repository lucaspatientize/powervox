---
/**
 * Footer — Matches Bricks Builder design
 * Soundwave background, logo, tagline, CTA buttons, copyright bar
 */
const year = new Date().getFullYear();
---

<!-- Main Footer -->
<footer class="site-footer">
  <div class="footer-bg">
    <div class="footer-overlay">
      <div class="footer-content">
        <!-- Logo -->
        <img
          src="/_emdash/api/media/file/01KNX79ZSX8TJ9MH53X6KTR069.png"
          alt="PowerVox"
          class="footer-logo"
        />

        <!-- Tagline -->
        <h2 class="footer-tagline">Eleve sua experiencia sonora</h2>

        <!-- Description & CTAs -->
        <div class="footer-inner">
          <p class="footer-text">
            Fundada em 1997, a Power Vox e uma empresa brasileira que se destaca na
            producao de alto-falantes de alta qualidade, tanto para uso automotivo
            quanto profissional.
          </p>

          <div class="footer-buttons">
            <a
              href="https://api.whatsapp.com/send?phone=556232827847"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              (62) 3282-7847
            </a>
            <a href="/distribuidores/" class="btn btn-secondary">
              Distribuidores
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- Copyright Bar -->
<div class="copyright-bar">
  <div class="container">
    <p>{year} &copy; PowerVox | All Rights Reserved</p>
  </div>
</div>

<style>
  .site-footer {
    margin-top: 0;
  }

  .footer-bg {
    background-color: #000;
    background-image: url('/_emdash/api/media/file/01KNX79Q9ZDVAJ25GJJFDJD49H.svg');
    background-size: 350%;
    background-repeat: repeat;
    background-position: center center;
    border-top: 1px solid #2b2b2b;
    border-bottom: 1px solid #2b2b2b;
  }

  .footer-overlay {
    background: rgba(0, 0, 0, 0.75);
    padding: 75px 15px;
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .footer-logo {
    height: 35px;
    width: auto;
    object-fit: contain;
    margin-bottom: 15px;
  }

  .footer-tagline {
    font-size: 32px;
    font-weight: 300;
    color: #fff;
    margin-bottom: 10px;
    font-family: 'Readex Pro', system-ui, sans-serif;
  }

  .footer-inner {
    max-width: 45%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer-text {
    color: #f5f5f5;
    text-align: center;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .footer-buttons {
    display: flex;
    gap: 35px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }

  .copyright-bar {
    background: #191919;
    padding: 25px 15px;
  }

  .copyright-bar p {
    color: #d4d4d4;
    text-align: center;
    margin: 0;
    font-size: 14px;
  }

  @media (max-width: 768px) {
    .footer-overlay {
      padding: 50px 35px;
    }

    .footer-inner {
      max-width: 75%;
    }

    .footer-tagline {
      font-size: 24px;
    }

    .footer-buttons {
      gap: 25px;
      flex-direction: column;
    }
  }
</style>
