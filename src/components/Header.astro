---
/**
 * Header — Matches Bricks Builder design
 * Black bar, logo left, mega-menu center, WhatsApp button right
 */
import { getEmDashCollection } from "@/utils/emdash";
import MegaMenu from "./MegaMenu.svelte";

// Fetch products for mega menu dropdown
const { entries: midbassProducts } = await getEmDashCollection("midbass", { status: "published" });
const { entries: subwooferProducts } = await getEmDashCollection("subwoofer", { status: "published" });

const EMDASH_BASE = "";

// Build simplified product data for the Svelte component
const midbassItems = (midbassProducts || []).map((p: any) => ({
  title: p.data?.title || "",
  slug: p.slug,
  image: p.data?.featured_image
    ? `${EMDASH_BASE}/_emdash/api/media/file/${p.data.featured_image.meta?.storageKey || ""}`
    : p.data?.thumbnail_url || "",
}));

const subwooferItems = (subwooferProducts || []).map((p: any) => ({
  title: p.data?.title || "",
  slug: p.slug,
  image: p.data?.featured_image
    ? `${EMDASH_BASE}/_emdash/api/media/file/${p.data.featured_image.meta?.storageKey || ""}`
    : p.data?.thumbnail_url || "",
}));
---

<header class="site-header">
  <div class="header-container mega-menu-container">
    <!-- Logo -->
    <div class="header-logo">
      <a href="/">
        <img
          src="/_emdash/api/media/file/01KNX79ZSX8TJ9MH53X6KTR069.png"
          alt="PowerVox"
          class="logo-img"
        />
      </a>
    </div>

    <!-- Navigation -->
    <div class="header-nav menu-navigation">
      <MegaMenu
        client:load
        midbassItems={midbassItems}
        subwooferItems={subwooferItems}
      />
    </div>

    <!-- WhatsApp Button -->
    <div class="header-cta">
      <a
        href="https://api.whatsapp.com/send?phone=556232827847"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary whatsapp-btn"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        (62) 3282-7847
      </a>
    </div>

    <!-- Mobile Toggle -->
    <button class="mobile-toggle" aria-label="Menu" id="mobile-toggle">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    background: #000;
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    padding: 15px 15px;
    gap: 50px;
    position: relative;
  }

  .header-logo {
    width: 25%;
    display: flex;
    align-items: flex-start;
  }

  .logo-img {
    height: auto;
    max-height: 50px;
    width: auto;
  }

  .header-nav {
    width: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .header-cta {
    width: 25%;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .whatsapp-btn {
    font-size: 14px;
    white-space: nowrap;
  }

  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    flex-direction: column;
    gap: 5px;
  }

  .mobile-toggle .bar {
    display: block;
    width: 24px;
    height: 2px;
    background: #fff;
    transition: 0.3s;
  }

  @media (max-width: 768px) {
    .header-container {
      padding: 15px;
    }

    .header-logo {
      width: 65%;
    }

    .header-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #191919;
      width: 100%;
      z-index: 999;
      padding: 35px;
    }

    .header-nav.open {
      display: flex;
    }

    .header-cta {
      display: none;
    }

    .mobile-toggle {
      display: flex;
      margin-left: auto;
    }
  }
</style>

<script>
  const toggle = document.getElementById("mobile-toggle");
  const nav = document.querySelector(".header-nav");
  toggle?.addEventListener("click", () => {
    nav?.classList.toggle("open");
  });
</script>
