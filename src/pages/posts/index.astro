---
/**
 * Blog posts archive — /posts/
 */
import Base from "@/layouts/Base.astro";
import { getEmDashCollection } from "@/utils/emdash";

const EMDASH_BASE = "";
const { entries: posts } = await getEmDashCollection("posts", { status: "published" });

function getImage(post: any) {
  if (post.data?.featured_image?.meta?.storageKey)
    return `${EMDASH_BASE}/_emdash/api/media/file/${post.data.featured_image.meta.storageKey}`;
  return "";
}
---

<Base title="Blog">
  <!-- Hero Bar -->
  <section class="hero-bar">
    <div class="container">
      <h1>Blog</h1>
    </div>
  </section>

  <!-- Posts Grid -->
  <section class="posts-section">
    <div class="container">
      <div class="posts-grid">
        {(posts || []).map((post: any) => (
          <article class="post-card">
            <a href={`/${post.slug}/`} class="post-image-link">
              {getImage(post) ? (
                <img src={getImage(post)} alt={post.data?.title} loading="lazy" />
              ) : (
                <div class="placeholder-img"></div>
              )}
            </a>
            <div class="post-content">
              <h3><a href={`/${post.slug}/`}>{post.data?.title}</a></h3>
              <a href={`/${post.slug}/`} class="read-more">Read more</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero Bar */
  .hero-bar {
    background: url("/_emdash/api/media/file/01KNX7CA9NFECY91VSHC4FBRGV.jpeg") no-repeat center center;
    background-attachment: fixed;
    background-size: cover;
    border-bottom: 2px solid #262626;
    padding: 60px 0;
  }
  .hero-bar h1 {
    color: #fff;
    font-size: 2.5rem;
  }

  /* Posts section */
  .posts-section {
    background: #121212;
    padding: 40px 0;
  }

  /* Posts Grid */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  /* Post Card */
  .post-card {
    border: 1px solid #F1D68F;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .post-image-link {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .post-image-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .post-image-link:hover img {
    transform: scale(1.05);
  }
  .placeholder-img {
    width: 100%;
    height: 100%;
    background: #1a1a1a;
  }

  .post-content {
    background: #121212;
    padding: 10px 25px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
  }
  .post-content h3 {
    margin-bottom: 10px;
  }
  .post-content h3 a {
    color: #fff;
    text-decoration: none;
    font-size: 1.1rem;
    line-height: 1.4;
  }
  .post-content h3 a:hover {
    color: #F1D68F;
  }

  .read-more {
    color: #F1D68F;
    text-decoration: underline;
    font-size: 14px;
  }
  .read-more:hover {
    color: #fff;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
