---
import Base from "@/layouts/Base.astro";
---

<Base title="Pagina nao encontrada">
  <section class="not-found">
    <div class="container">
      <h1>404</h1>
      <p>Pagina nao encontrada</p>
      <a href="/" class="btn btn-primary">Voltar para Home</a>
    </div>
  </section>
</Base>

<style>
  .not-found { text-align: center; padding: 100px 0; background: #000; color: #fff; min-height: 50vh; display: flex; align-items: center; justify-content: center; }
  .not-found .container { display: flex; flex-direction: column; align-items: center; gap: 15px; }
  .not-found h1 { font-size: 8rem; color: var(--color-primary); line-height: 1; }
  .not-found p { font-size: 1.25rem; color: #999; }
</style>
