---
/**
 * Contact Page — /contato/
 */
import Base from "@/layouts/Base.astro";
---

<Base title="Contato" description="Fale com a Powervox. Nossa equipe tecnica e comercial esta pronta para ajudar voce.">
  <!-- ========== HERO BANNER ========== -->
  <section class="contato-hero">
    <div class="contato-hero-container">
      <div class="contato-hero-text">
        <h1>Contato</h1>
        <p>
          Fale com a Powervox. Nossa equipe tecnica e comercial esta pronta para
          ajudar voce a escolher a solucao ideal — do audio automotivo aos
          sistemas profissionais. Tire duvidas sobre especificacoes, solicite
          orcamentos e receba indicacao de distribuidores em todo o Brasil.
        </p>
      </div>
      <div class="contato-hero-map">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d7642.273909015154!2d-49.232644!3d-16.720017000000002!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x935ef0437eabdf67%3A0x9a993d6d6d8b533e!2sVox%20Power%20Industry%20and%20Trade%20electroacoustic!5e0!3m2!1sen!2sus!4v1728243192380!5m2!1sen!2sus"
          width="100%"
          height="350"
          style="border:0; border-radius: 8px;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Power Vox Location"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ========== CONTACT INFO + FORM ========== -->
  <section class="contato-main">
    <div class="contato-main-bg"></div>
    <div class="contato-main-overlay"></div>
    <div class="contato-main-container">
      <!-- LEFT: Contact Info -->
      <div class="contato-info">
        <ul class="contato-list">
          <li>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            <a href="tel:+556232827847">(62) 3282-7847</a>
          </li>
          <li>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.5.5 0 00.611.611l4.458-1.495A11.943 11.943 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-2.319 0-4.476-.673-6.303-1.834l-.44-.276-3.228 1.082 1.082-3.228-.276-.44A9.953 9.953 0 012 12C2 6.486 6.486 2 12 2s10 4.486 10 10-4.486 10-10 10z"/></svg>
            <a href="https://api.whatsapp.com/send?phone=556232827847" target="_blank" rel="noopener">(62) 3282-7847</a>
          </li>
          <li>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <a href="mailto:powervoxind@hotmail.com">powervoxind@hotmail.com</a>
          </li>
          <li>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Av. Uberaba, 237 QD 36 LT 20 Vila Alto da Gloria CEP: 74.815-350 GOIANIA-GO</span>
          </li>
        </ul>
        <div class="contato-social">
          <a href="https://www.facebook.com/681179841895143" target="_blank" rel="noopener" class="contato-facebook-link">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            Power Vox no Facebook
          </a>
        </div>
      </div>

      <!-- RIGHT: Contact Form -->
      <div class="contato-form-wrapper">
        <h2>Entre em contato</h2>
        <form class="contato-form" action="https://api.whatsapp.com/send?phone=556232827847" method="get" target="_blank">
          <div class="form-group">
            <label for="nome">Nome</label>
            <input type="text" id="nome" name="nome" placeholder="Seu nome completo" required />
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="seu@email.com" required />
          </div>
          <div class="form-group">
            <label for="telefone">Telefone</label>
            <input type="tel" id="telefone" name="telefone" placeholder="(00) 00000-0000" />
          </div>
          <div class="form-group">
            <label for="mensagem">Mensagem</label>
            <textarea id="mensagem" name="text" rows="5" placeholder="Sua mensagem..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary contato-submit">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
            Enviar Mensagem
          </button>
        </form>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ===== HERO BANNER ===== */
  .contato-hero {
    background: url('/_emdash/api/media/file/01KNX7CA9NFECY91VSHC4FBRGV.jpeg') no-repeat center center;
    background-attachment: fixed;
    background-size: cover;
    padding: 100px 0;
    border-bottom: 2px solid #262626;
  }

  .contato-hero-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 15px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 50px;
  }

  .contato-hero-text {
    flex: 1;
  }

  .contato-hero-text h1 {
    color: #fff;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    margin-bottom: 20px;
  }

  .contato-hero-text p {
    color: #fff;
    font-size: 20px;
    font-weight: 300;
    line-height: 1.7;
  }

  .contato-hero-map {
    flex: 1;
  }

  .contato-hero-map iframe {
    display: block;
  }

  /* ===== CONTACT INFO + FORM ===== */
  .contato-main {
    position: relative;
    padding: 100px 0;
    overflow: hidden;
  }

  .contato-main-bg {
    position: absolute;
    inset: 0;
    background-color: #000;
    background-image: url('/_emdash/api/media/file/01KNX7C9T3KSCCT2CHKMCQF3PH.jpeg');
    background-position: bottom left;
    background-size: contain;
    background-repeat: no-repeat;
    z-index: 0;
  }

  .contato-main-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 1) 25%, rgba(0, 0, 0, 0.68) 100%);
    z-index: 1;
  }

  .contato-main-container {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 15px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 100px;
  }

  /* LEFT: Contact Info */
  .contato-info {
    flex: 1;
  }

  .contato-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
    list-style: none;
    padding: 0;
  }

  .contato-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: #fff;
    font-weight: 300;
    line-height: 1.6;
  }

  .contato-list li svg {
    flex-shrink: 0;
    margin-top: 3px;
  }

  .contato-list li a {
    color: #fff;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .contato-list li a:hover {
    color: var(--color-secondary);
  }

  .contato-social {
    margin-top: 25px;
  }

  .contato-facebook-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #fff;
    font-weight: 300;
    transition: color 0.3s ease;
  }

  .contato-facebook-link:hover {
    color: var(--color-secondary);
  }

  /* RIGHT: Contact Form */
  .contato-form-wrapper {
    flex: 1;
    background: #000;
    border: 1px solid var(--color-secondary);
    border-radius: 8px;
    padding: 50px;
  }

  .contato-form-wrapper h2 {
    color: #fff;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    margin-bottom: 25px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    color: #fff;
    font-weight: 400;
    font-size: 14px;
    margin-bottom: 6px;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 12px 16px;
    background: #191919;
    border: 1px solid #333;
    border-radius: 6px;
    color: #fff;
    font-family: var(--font-family);
    font-size: 15px;
    font-weight: 300;
    transition: border-color 0.3s ease;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: #666;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-secondary);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 100px;
  }

  .contato-submit {
    width: 100%;
    justify-content: center;
    font-size: 16px;
    padding: 14px 28px;
    margin-top: 5px;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .contato-hero {
      padding: 50px 35px;
      background-attachment: scroll;
    }

    .contato-hero-container {
      flex-direction: column;
      gap: 35px;
    }

    .contato-main {
      padding: 50px 35px;
    }

    .contato-main-container {
      flex-direction: column;
      gap: 50px;
    }

    .contato-info {
      order: 2;
    }

    .contato-form-wrapper {
      order: 1;
      padding: 25px;
    }
  }
</style>
