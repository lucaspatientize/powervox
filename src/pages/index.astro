---
/**
 * Homepage — https://powervox.com.br/
 * Matches Bricks Builder design:
 * 1. Hero with video background
 * 2. Benefits (3 icon boxes)
 * 3. Products (tabbed carousel)
 * 4. About section
 * 5. Client gallery carousel
 */
import Base from "@/layouts/Base.astro";
import { getEmDashCollection } from "@/utils/emdash";
import ProductTabs from "@/components/ProductTabs.svelte";
import ImageGallery from "@/components/ImageGallery.svelte";

const EMDASH_BASE = "";

// Fetch products for carousel
const { entries: midbassRaw } = await getEmDashCollection("midbass", { status: "published" });
const { entries: subwooferRaw } = await getEmDashCollection("subwoofer", { status: "published" });

const midbassProducts = (midbassRaw || []).map((p: any) => ({
  title: p.data?.title || "",
  slug: p.slug,
  basePath: "/produtos/mid-bass",
  image: p.data?.featured_image?.meta?.storageKey
    ? `${EMDASH_BASE}/_emdash/api/media/file/${p.data.featured_image.meta.storageKey}`
    : p.data?.thumbnail_url || "",
}));

const subwooferProducts = (subwooferRaw || []).map((p: any) => ({
  title: p.data?.title || "",
  slug: p.slug,
  basePath: "/produtos/subwoofer",
  image: p.data?.featured_image?.meta?.storageKey
    ? `${EMDASH_BASE}/_emdash/api/media/file/${p.data.featured_image.meta.storageKey}`
    : p.data?.thumbnail_url || "",
}));

// Client gallery images
const galleryImages = [
  { src: "/_emdash/api/media/file/01KNX79W9521P7WYWAY9Q4YTZX.jpg", alt: "PowerVox Client" },
  { src: "/_emdash/api/media/file/01KNX79VZKSDADYTP40MK6C8NR.jpg", alt: "PowerVox Client" },
  { src: "/_emdash/api/media/file/01KNX79VNNJ64N46WE9EWZVXTA.jpg", alt: "PowerVox Client" },
  { src: "/_emdash/api/media/file/01KNX79VBV7RHJZ3JDSBCSXGMT.jpg", alt: "PowerVox Client" },
  { src: "/_emdash/api/media/file/01KNX79V213E41V5STC48GBF89.jpg", alt: "PowerVox Client" },
  { src: "/_emdash/api/media/file/01KNX79TR398R76JVHMXZKP2T1.jpg", alt: "PowerVox Client" },
  { src: "/_emdash/api/media/file/01KNX79SZMYZJE3E46RV5X10F1.jpg", alt: "PowerVox Client" },
];
---

<Base title="Home">
  <!-- ========== HERO SECTION ========== -->
  <section class="hero-section">
    <video autoplay muted loop playsinline class="hero-video">
      <source src="/video/powervox-hero-bg.mp4" type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1 class="hero-title">Qualidade que se ouve</h1>
      <h4 class="hero-subtitle">Mais de 30 anos de excelencia</h4>
    </div>
  </section>

  <!-- ========== BENEFITS SECTION ========== -->
  <section class="benefits-section">
    <div class="benefits-container">
      <div class="benefit-item fade-in">
        <div class="benefit-icon">
          <svg viewBox="0 0 24 24" width="50" height="50" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="8" r="5" />
            <path d="M12 13v3M8 22h8M7 16l-2 6M17 16l2 6" />
            <path d="M9 6.5l1.5 2L15 5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <div class="benefit-text">
          <h3>QUALIDADE</h3>
          <p>Trabalhamos com materia prima selecionada.</p>
        </div>
      </div>

      <div class="benefit-item fade-in fade-in-delay-1">
        <div class="benefit-icon">
          <svg viewBox="0 0 24 24" width="50" height="50" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2" y="3" width="20" height="14" rx="2" />
            <path d="M8 21h8M12 17v4" />
            <path d="M7 8h4M7 11h6" />
          </svg>
        </div>
        <div class="benefit-text">
          <h3>DESIGN</h3>
          <p>Trata de melhorias no processo de producao de nosso produtos.</p>
        </div>
      </div>

      <div class="benefit-item fade-in fade-in-delay-2">
        <div class="benefit-icon">
          <svg viewBox="0 0 24 24" width="50" height="50" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z" />
          </svg>
        </div>
        <div class="benefit-text">
          <h3>ATENDIMENTO</h3>
          <p>Entendemos que a parte mais importante de qualquer processo sao as pessoas.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PRODUCTS SECTION ========== -->
  <section class="products-section">
    <div class="products-bg"></div>
    <div class="products-overlay">
      <div class="products-container">
        <ProductTabs
          client:load
          midbassProducts={midbassProducts}
          subwooferProducts={subwooferProducts}
        />
        <div class="products-cta">
          <a href="/produtos/" class="btn btn-secondary">More Products</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ABOUT SECTION ========== -->
  <section class="about-section">
    <div class="about-container">
      <div class="about-text">
        <h2>Mais de 30 anos de excelencia</h2>
        <p>
          Localizada no Brasil, nossa fabrica e uma pioneira unica na industria de
          alto-falantes automotivos. Nos orgulhamos de ser uma das poucas instalacoes
          no mundo que fabrica todos os componentes dos nossos alto-falantes internamente.
        </p>
        <a href="/sobre/" class="btn btn-primary">Sobre Nos</a>
      </div>
      <div class="about-image">
        <img
          src="/_emdash/api/media/file/01KNX79TDWY4MHH04PZ75NFFGE.jpg"
          alt="Fabrica PowerVox"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ========== CLIENT GALLERY ========== -->
  <section class="gallery-section">
    <ImageGallery client:visible images={galleryImages} />
  </section>
</Base>

<style>
  /* ===== HERO ===== */
  .hero-section {
    position: relative;
    height: 800px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-video {
    position: absolute;
    top: 50%;
    left: 50%;
    min-width: 100%;
    min-height: 100%;
    transform: translate(-50%, -50%);
    object-fit: cover;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 35px;
  }

  .hero-title {
    color: #fff;
    text-transform: uppercase;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    margin-bottom: 0;
    line-height: 1.1;
  }

  .hero-subtitle {
    color: #fff;
    font-weight: 300;
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    margin-bottom: 35px;
  }

  /* ===== BENEFITS ===== */
  .benefits-section {
    background: #fff;
    padding: 0;
  }

  .benefits-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: 50px;
    padding: 35px 15px;
  }

  .benefit-item {
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 25px;
  }

  .benefit-icon {
    flex-shrink: 0;
    color: #000;
  }

  .benefit-text h3 {
    font-size: 30px;
    font-weight: 700;
    color: #000;
    margin-bottom: 5px;
    font-family: 'Readex Pro', system-ui, sans-serif;
  }

  .benefit-text p {
    font-size: 15px;
    color: #333;
    line-height: 1.5;
  }

  /* ===== PRODUCTS ===== */
  .products-section {
    position: relative;
    overflow: hidden;
  }

  .products-bg {
    position: absolute;
    inset: 0;
    background-color: #000;
    background-image: url('/_emdash/api/media/file/01KNX7A0GJYP2WDP9MAYX3RSDP.svg');
    background-size: cover;
    z-index: 0;
  }

  .products-overlay {
    position: relative;
    z-index: 1;
    background: rgba(0, 0, 0, 0.83);
    padding: 60px 15px;
  }

  .products-container {
    max-width: 80%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .products-cta {
    margin-top: 20px;
  }

  /* ===== ABOUT ===== */
  .about-section {
    background: #fff;
    padding: 60px 15px;
  }

  .about-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: 50px;
    align-items: stretch;
  }

  .about-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    text-align: left;
  }

  .about-text h2 {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    color: #000;
    line-height: 1;
    margin-bottom: 15px;
  }

  .about-text p {
    text-align: left;
    line-height: 1.7;
    margin-bottom: 25px;
    color: #333;
  }

  .about-image {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-image img {
    width: 100%;
    height: 500px;
    object-fit: cover;
    border-radius: 10px;
  }

  /* ===== GALLERY ===== */
  .gallery-section {
    background: #000;
    padding: 0;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 1024px) {
    .products-container {
      max-width: 95%;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      height: 50vh;
    }

    .hero-content {
      align-self: flex-start;
    }

    .benefits-container {
      flex-direction: column;
      gap: 15px;
      padding: 35px;
    }

    .benefit-item {
      flex-direction: row;
    }

    .benefit-text h3 {
      font-size: 22px;
    }

    .products-overlay {
      padding: 35px 15px;
    }

    .products-container {
      max-width: 100%;
    }

    .products-cta {
      margin-top: 0;
    }

    .about-container {
      flex-direction: column;
      gap: 50px;
    }

    .about-section {
      padding: 35px;
    }

    .about-image img {
      height: 300px;
    }
  }
</style>
