---
/**
 * Single subwoofer product — /produtos/subwoofer/[slug]/
 * Bricks Builder design: hero + specs/params + caixa sections + related products
 */
import Base from "@/layouts/Base.astro";
import { getEmDashEntry, getEmDashCollection } from "@/utils/emdash";
import ProductCarousel from "@/components/ProductCarousel.svelte";

const EMDASH_BASE = "";
const { slug } = Astro.params;
if (!slug) return Astro.redirect("/produtos/subwoofer/");

const { entry: product, error } = await getEmDashEntry("subwoofer", slug);
if (error || !product) return Astro.redirect("/produtos/subwoofer/");

const imageUrl = product.data?.featured_image?.meta?.storageKey
  ? `${EMDASH_BASE}/_emdash/api/media/file/${product.data.featured_image.meta.storageKey}`
  : product.data?.thumbnail_url || "";

/* Caixa data flags */
const hasCaixaFechada = product.data?.caixa_redondo_fechada || product.data?.caixa_retangular_fechada;
const hasCaixaAberto = product.data?.caixa_redondo_aberto || product.data?.caixa_retangular_aberto;

/* Related products: other subwoofers + midbass */
const { entries: allSubwoofers } = await getEmDashCollection("subwoofer", { status: "published" });
const { entries: allMidbass } = await getEmDashCollection("midbass", { status: "published" });

const relatedProducts = [
  ...(allSubwoofers || []).filter((p: any) => p.slug !== slug),
  ...(allMidbass || []),
].slice(0, 12).map((p: any) => ({
  title: p.data?.title || "",
  slug: p.slug,
  basePath: `/produtos/${p.collection === "subwoofer" ? "subwoofer" : "mid-bass"}`,
  image: p.data?.featured_image?.meta?.storageKey
    ? `${EMDASH_BASE}/_emdash/api/media/file/${p.data.featured_image.meta.storageKey}`
    : p.data?.thumbnail_url || "",
}));
---

<Base title={product.data?.title || "Subwoofer"}>
  <!-- SECTION 1: Product Hero -->
  <section class="product-hero">
    <div class="hero-overlay"></div>
    <div class="hero-container">
      <div class="hero-image">
        {imageUrl && <img src={imageUrl} alt={product.data?.title} />}
      </div>
      <div class="hero-info">
        <nav class="breadcrumb">
          <a href="/">Home</a> &raquo;
          <a href="/produtos/">Produtos</a> &raquo;
          <a href="/produtos/subwoofer/">Subwoofer</a> &raquo;
          <span>{product.data?.title}</span>
        </nav>
        <h1>{product.data?.title}</h1>
        <div class="hero-ctas">
          <a
            href="https://api.whatsapp.com/send?phone=556232827847"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-whatsapp"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            (62) 3282-7847
          </a>
          <a href="/distribuidores/" class="btn-distribuidores">
            Distribuidores
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: Specifications + TS Parameters -->
  {(product.data?.specifications_html || product.data?.parameters_html) && (
    <section class="specs-section">
      <div class="specs-container">
        {product.data?.specifications_html && (
          <div class="spec-column">
            <div class="spec-tab">
              <h3>Specifications</h3>
            </div>
            <div class="spec-content" set:html={product.data.specifications_html} />
          </div>
        )}
        {product.data?.parameters_html && (
          <div class="spec-column">
            <div class="spec-tab">
              <h3>TS Parametros</h3>
            </div>
            <div class="spec-content" set:html={product.data.parameters_html} />
          </div>
        )}
      </div>
      <div class="seal-images">
        <img src="/_emdash/api/media/file/01KNX7C92RYJPRA562TQN3CZ7N.png" alt="Selo 2" />
        <img src="/_emdash/api/media/file/01KNX7C9BHZNRTJV9ZAN83QG5Z.png" alt="Selo 1" />
      </div>
    </section>
  )}

  <!-- SECTION 3A: Caixa Veiculo Fechado -->
  {hasCaixaFechada && (
    <section class="caixa-section caixa-fechada">
      <div class="caixa-heading">
        <span class="heading-line"></span>
        <h2>Criação de Caixa Veículo Fechado</h2>
        <span class="heading-line"></span>
      </div>
      <div class="caixa-cards">
        {product.data?.caixa_redondo_fechada && (
          <div class="caixa-card">
            <div class="caixa-card-header">
              <h3>Caixa Duto Redondo</h3>
              <img src="/_emdash/api/media/file/01KNX7CBP7N38KEW2ZE3D36HDW.png" alt="Caixa Duto Redondo" />
            </div>
            <div class="caixa-card-body" set:html={product.data.caixa_redondo_fechada} />
          </div>
        )}
        {product.data?.caixa_retangular_fechada && (
          <div class="caixa-card">
            <div class="caixa-card-header">
              <h3>Caixa Duto Retangular</h3>
              <img src="/_emdash/api/media/file/01KNX7CC6XHE2FXA6QJHXB8P8A.png" alt="Caixa Duto Retangular" />
            </div>
            <div class="caixa-card-body" set:html={product.data.caixa_retangular_fechada} />
          </div>
        )}
      </div>
    </section>
  )}

  <!-- SECTION 3B: Caixa Veiculo Aberto -->
  {hasCaixaAberto && (
    <section class="caixa-section caixa-aberto">
      <div class="caixa-heading">
        <span class="heading-line"></span>
        <h2>Criação de Caixa Veículo Aberto</h2>
        <span class="heading-line"></span>
      </div>
      <div class="caixa-cards">
        {product.data?.caixa_redondo_aberto && (
          <div class="caixa-card">
            <div class="caixa-card-header">
              <h3>Caixa Duto Redondo</h3>
              <img src="/_emdash/api/media/file/01KNX7CBP7N38KEW2ZE3D36HDW.png" alt="Caixa Duto Redondo" />
            </div>
            <div class="caixa-card-body" set:html={product.data.caixa_redondo_aberto} />
          </div>
        )}
        {product.data?.caixa_retangular_aberto && (
          <div class="caixa-card">
            <div class="caixa-card-header">
              <h3>Caixa Duto Retangular</h3>
              <img src="/_emdash/api/media/file/01KNX7CC6XHE2FXA6QJHXB8P8A.png" alt="Caixa Duto Retangular" />
            </div>
            <div class="caixa-card-body" set:html={product.data.caixa_retangular_aberto} />
          </div>
        )}
      </div>
    </section>
  )}

  <!-- SECTION 4: Related Products -->
  {relatedProducts.length > 0 && (
    <section class="related-section">
      <div class="related-container">
        <h2>Produtos Relacionados</h2>
        <ProductCarousel client:load products={relatedProducts} slidesToShow={4} autoplaySpeed={5000} />
      </div>
    </section>
  )}
</Base>

<style>
  /* ===== SECTION 1: HERO ===== */
  .product-hero {
    position: relative;
    background-color: #000;
    background-image: url('/_emdash/api/media/file/01KNX79Q9ZDVAJ25GJJFDJD49H.svg');
    background-size: cover;
    background-position: center;
    padding: 25px 0 50px;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    z-index: 0;
  }
  .hero-container {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 50px;
  }
  .hero-image {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-image img {
    max-width: 100%;
    border-radius: 10px;
  }
  .hero-info {
    flex: 1;
  }
  .breadcrumb {
    color: #fff;
    font-size: 0.85rem;
    margin-bottom: 15px;
  }
  .breadcrumb a {
    color: #fff;
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .hero-info h1 {
    color: #fff;
    font-size: 2.2rem;
    margin: 0 0 25px;
    line-height: 1.2;
  }
  .hero-ctas {
    display: flex;
    flex-direction: row;
    gap: 25px;
    flex-wrap: wrap;
  }
  .btn-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-primary, #AB3335);
    color: #fff;
    padding: 12px 24px;
    border-radius: var(--radius-md, 8px);
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    transition: opacity 0.2s;
  }
  .btn-whatsapp:hover {
    opacity: 0.9;
  }
  .btn-distribuidores {
    display: inline-flex;
    align-items: center;
    background: #000;
    color: #fff;
    padding: 12px 28px;
    border-radius: var(--radius-lg, 10px);
    border: 1px solid var(--color-secondary, #F1D68F);
    text-decoration: none;
    font-weight: 500;
    font-size: 15px;
    transition: background 0.3s, color 0.3s;
  }
  .btn-distribuidores:hover {
    background: var(--color-secondary, #F1D68F);
    color: #000;
  }

  /* ===== SECTION 2: SPECS ===== */
  .specs-section {
    background: #000;
    padding: 10px 0 100px;
  }
  .specs-container {
    max-width: 1200px;
    width: 90%;
    margin: 0 auto;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 30px;
  }
  .spec-column {
    flex: 1;
    min-width: 0;
  }
  .spec-tab {
    background: #fff;
    padding: 10px 25px;
    border-radius: 0 10px 0 0;
    display: inline-block;
  }
  .spec-tab h3 {
    color: #191919;
    font-size: 25px;
    font-weight: 300;
    margin: 0;
  }
  .spec-content {
    border: 1px solid #fff;
    border-radius: 0 0 10px 10px;
    padding: 25px;
    color: #fff;
  }
  :global(.spec-content ul) { list-style: none; padding: 0; margin: 0; }
  :global(.spec-content li) { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.15); }
  :global(.spec-content table) { width: 100%; border-collapse: collapse; }
  :global(.spec-content td),
  :global(.spec-content th) { padding: 8px 4px; border-bottom: 1px solid rgba(255, 255, 255, 0.15); text-align: left; }
  :global(.spec-content p) { margin: 5px 0; }

  .seal-images {
    display: flex;
    flex-direction: row;
    gap: 15px;
    justify-content: center;
    margin-top: 15px;
  }
  .seal-images img {
    max-height: 80px;
    width: auto;
  }

  /* ===== SECTION 3: CAIXA ===== */
  .caixa-section {
    padding: 60px 20px;
  }
  .caixa-fechada {
    background: #fff;
  }
  .caixa-aberto {
    background: #F2F2F2;
    margin-bottom: 75px;
  }

  .caixa-heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 40px;
  }
  .heading-line {
    display: block;
    width: 100px;
    height: 5px;
    background: var(--color-primary, #AB3335);
  }
  .caixa-heading h2 {
    font-size: 42px;
    color: #191919;
    margin: 0;
    text-align: center;
    white-space: nowrap;
  }

  .caixa-cards {
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
    max-width: 1200px;
    margin: 0 auto;
  }
  .caixa-card {
    width: 40%;
    min-width: 280px;
    border: 2px solid var(--color-secondary, #F1D68F);
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
  }
  .caixa-card-header {
    background: #000;
    min-height: 250px;
    padding: 35px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .caixa-card-header h3 {
    color: #fff;
    font-size: 25px;
    font-weight: 500;
    margin: 0 0 20px;
    text-align: center;
  }
  .caixa-card-header img {
    max-width: 100%;
    max-height: 160px;
    width: auto;
  }
  .caixa-card-body {
    background: #fff;
    padding: 15px 35px;
    color: #191919;
  }
  :global(.caixa-card-body ul) { list-style: none; padding: 0; margin: 0; }
  :global(.caixa-card-body li) { padding: 6px 0; border-bottom: 1px solid #eee; }
  :global(.caixa-card-body table) { width: 100%; border-collapse: collapse; }
  :global(.caixa-card-body td),
  :global(.caixa-card-body th) { padding: 6px 4px; border-bottom: 1px solid #eee; text-align: left; }
  :global(.caixa-card-body p) { margin: 5px 0; }

  /* ===== SECTION 4: RELATED ===== */
  .related-section {
    background: linear-gradient(to bottom, #000, #191919);
    padding: 0 0 75px;
  }
  .related-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .related-container h2 {
    color: #fff;
    font-size: 1.8rem;
    margin-bottom: 30px;
    padding-top: 40px;
  }

  /* ===== MOBILE ===== */
  @media (max-width: 768px) {
    .product-hero {
      padding: 40px 0 30px;
    }
    .hero-container {
      flex-direction: column;
      gap: 20px;
    }
    .hero-image {
      width: 100%;
      max-width: 280px;
      margin: 0 auto;
    }
    .hero-info {
      width: 100%;
      text-align: center;
    }
    .hero-info h1 {
      font-size: 1.6rem;
    }
    .breadcrumb {
      font-size: 0.75rem;
    }
    .specs-section {
      padding: 25px 0 50px;
    }
    .specs-container {
      flex-direction: column;
      width: 100%;
      padding: 0 15px;
    }
    .spec-column {
      width: 100%;
    }
    .caixa-section {
      padding: 40px 15px;
    }
    .caixa-heading h2 {
      font-size: 22px;
      white-space: normal;
    }
    .heading-line {
      width: 40px;
    }
    .caixa-card {
      width: 100%;
      min-width: unset;
    }
    .caixa-aberto {
      margin-bottom: 0;
    }
    .related-section {
      padding: 40px 0 40px;
    }
    .related-container {
      padding: 0 0 0 15px;
    }
    .hero-ctas {
      flex-direction: column;
      gap: 12px;
      align-items: stretch;
    }
    .btn-whatsapp,
    .btn-distribuidores {
      width: 100%;
      justify-content: center;
    }
  }
</style>
