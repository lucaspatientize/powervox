---
/**
 * Subwoofer archive — /produtos/subwoofer/
 */
import Base from "@/layouts/Base.astro";
import { getEmDashCollection } from "@/utils/emdash";

const EMDASH_BASE = "";
const { entries: subwoofers } = await getEmDashCollection("subwoofer", { status: "published" });

function getImage(p: any) {
  if (p.data?.featured_image?.meta?.storageKey)
    return `${EMDASH_BASE}/_emdash/api/media/file/${p.data.featured_image.meta.storageKey}`;
  return "";
}
---

<Base title="Subwoofers">
  <!-- Hero Bar -->
  <section class="hero-bar">
    <div class="container">
      <h1>Subwoofers</h1>
      <p class="hero-desc">Subwoofers de alta potência para graves profundos e precisos. Qualidade sonora que se ouve e se sente.</p>
    </div>
  </section>

  <!-- Product Grid -->
  <section class="products-section">
    <div class="container">
      <div class="product-grid">
        {(subwoofers || []).map((p: any) => (
          <div class="product-card">
            <a href={`/produtos/subwoofer/${p.slug}/`} class="card-image-link">
              {getImage(p) && <img src={getImage(p)} alt={p.data?.title} loading="lazy" />}
            </a>
            <h3>{p.data?.title}</h3>
            <a href={`/produtos/subwoofer/${p.slug}/`} class="view-link">View Product <span class="arrow">&rarr;</span></a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero Bar */
  .hero-bar {
    background: url("/_emdash/api/media/file/01KNX7CA9NFECY91VSHC4FBRGV.jpeg") no-repeat center center;
    background-attachment: fixed;
    background-size: cover;
    border-bottom: 2px solid #262626;
    padding: 60px 0;
  }
  .hero-bar h1 {
    color: #fff;
    font-size: 2.5rem;
  }
  .hero-desc {
    color: #fff;
    font-size: 20px;
    margin-top: 15px;
    max-width: 800px;
  }

  /* Products section dark background */
  .products-section {
    background: #121212;
    padding: 40px 0;
  }

  /* Product Grid */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  /* Product Card */
  .product-card {
    background: #191919;
    padding: 25px;
    border: 1px solid #454545;
    border-radius: 5px;
    text-align: center;
    transition: border-color 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .product-card:hover {
    border-color: #F1D68F;
  }
  .card-image-link {
    display: block;
    width: 100%;
    margin-bottom: 15px;
  }
  .card-image-link img {
    width: 100%;
    max-width: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }
  .product-card:hover .card-image-link img {
    animation: pulse 1s ease-in-out infinite;
  }
  .product-card h3 {
    color: #fff;
    font-size: 25px;
    font-weight: 600;
    margin-bottom: 15px;
  }
  .view-link {
    color: #F1D68F;
    text-decoration: none;
    font-size: 16px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: auto;
  }
  .view-link .arrow {
    transition: transform 0.2s ease;
  }
  .view-link:hover .arrow {
    transform: translateX(3px);
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.03); }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
