---
/**
 * Catch-all for CMS pages and posts
 * Title Bar design: soundwave bg, featured image left, title/breadcrumbs/buttons right
 */
import Base from "@/layouts/Base.astro";
import { getEmDashEntry } from "@/utils/emdash";
import { PortableText } from "emdash/ui";

const EMDASH_BASE = "";
const { slug } = Astro.params;
if (!slug) return Astro.redirect("/");

let entry: any = null;
let collection = "";

const pagesResult = await getEmDashEntry("pages", slug);
if (pagesResult.entry) {
  entry = pagesResult.entry;
  collection = "pages";
} else {
  const postsResult = await getEmDashEntry("posts", slug);
  if (postsResult.entry) {
    entry = postsResult.entry;
    collection = "posts";
  }
}

if (!entry) return Astro.redirect("/404/");

const imageUrl = entry.data?.featured_image?.meta?.storageKey
  ? `${EMDASH_BASE}/_emdash/api/media/file/${entry.data.featured_image.meta.storageKey}`
  : "";
---

<Base title={entry.data?.title}>
  <!-- Title Bar -->
  <section class="title-bar">
    <div class="title-overlay"></div>
    <div class="title-container">
      {imageUrl && (
        <div class="title-image">
          <img src={imageUrl} alt={entry.data?.title} />
        </div>
      )}
      <div class="title-info">
        <nav class="breadcrumb">
          <a href="/">Home</a> &raquo;
          {collection === "posts" && <><a href="/posts/">Blog</a> &raquo;</>}
          <span>{entry.data?.title}</span>
        </nav>
        <h1>{entry.data?.title}</h1>
        <div class="title-ctas">
          <a
            href="https://api.whatsapp.com/send?phone=556232827847"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            62-3282-3053
          </a>
          <a href="/distribuidores/" class="btn btn-secondary">Distribuidores</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Page Content -->
  <article class="page-content">
    <div class="container">
      {entry.data?.content && (
        <div class="content-body">
          <PortableText value={entry.data.content} />
        </div>
      )}
    </div>
  </article>
</Base>

<style>
  .title-bar {
    position: relative;
    background-color: #000;
    background-image: url('/_emdash/api/media/file/01KNX79Q9ZDVAJ25GJJFDJD49H.svg');
    background-size: cover;
    background-position: center;
    padding: 25px 0 50px;
  }
  .title-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    z-index: 0;
  }
  .title-container {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 50px;
  }
  .title-image {
    flex-shrink: 0;
    max-width: 40%;
  }
  .title-image img {
    max-width: 100%;
    border-radius: 8px;
  }
  .title-info {
    flex: 1;
  }
  .breadcrumb {
    color: #fff;
    font-size: 0.85rem;
    margin-bottom: 15px;
  }
  .breadcrumb a {
    color: #fff;
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .title-info h1 {
    color: #fff;
    font-size: 2.5rem;
    margin: 0 0 25px;
    line-height: 1.2;
  }
  .title-ctas {
    display: flex;
    gap: 25px;
    flex-wrap: wrap;
  }
  .page-content {
    background: #000;
    color: #fff;
    padding: 50px 0 80px;
  }
  .content-body {
    max-width: 800px;
    line-height: 1.8;
  }
  .content-body :global(p) { margin-bottom: 1rem; }
  .content-body :global(h2) { font-size: 1.5rem; margin: 2rem 0 1rem; }
  .content-body :global(h3) { font-size: 1.25rem; margin: 1.5rem 0 0.75rem; }
  .content-body :global(ul), .content-body :global(ol) { margin-left: 1.5rem; margin-bottom: 1rem; }
  .content-body :global(img) { border-radius: 8px; margin: 1rem 0; }
  .content-body :global(a) { color: var(--color-secondary, #F1D68F); }

  @media (max-width: 768px) {
    .title-bar { padding: 50px 0 25px; }
    .title-container {
      flex-direction: column;
      gap: 25px;
      padding: 0 35px;
    }
    .title-image { max-width: 100%; }
    .title-ctas {
      flex-direction: column;
      gap: 15px;
    }
    .page-content { padding: 35px 0 50px; }
  }
</style>
